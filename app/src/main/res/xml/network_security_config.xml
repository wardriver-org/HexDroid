<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- Dynamic self-hosted endpoints cannot be enumerated here. Application transports
         enforce HTTPS, except an explicitly enabled uploader endpoint and Tor onion previews. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- This onion endpoint uses HTTP inside the authenticated Tor circuit.
         The uploader routes it exclusively through Orbot when explicitly enabled. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">4fmncziybi5ivolw3mhafssgeeralxcbos3lo6y5iwpnzw3hqsvn4xyd.onion</domain>
    </domain-config>

    <!-- If you ever want to allow cleartext for specific hosts, add a domain-config:
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">irc.example.org</domain>
    </domain-config>
    -->

    <!-- Debug only: allow user-added CAs for testing self-signed certs. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
